#!/bin/bash

# 腾讯会议（wemeet）RPM 维护脚本公共函数（由官方 .deb 的 control 脚本移植）
WEMEET_LOG_PATH="/var/log/wemeet/rpm-install.log"
WEMEET_APP_DIR="/opt/wemeet"
WEMEET_DESKTOP_NAME="wemeetapp"

WemeetLog()
{
	if [ $# -lt 2 ]; then
		return 0
	fi
	local LOG_LEV="$1"
	local LOG_FMT="$2"
	shift 2

	local log_dir
	log_dir=$(dirname "$WEMEET_LOG_PATH")
	if [ ! -d "$log_dir" ]; then
		mkdir -p "$log_dir" 2>/dev/null
	fi

	local line
	line="[$(date '+%Y-%m-%d %H:%M:%S')] [$LOG_LEV] ${LOG_FMT} $*"
	echo "$line"
	echo "$line" >> "$WEMEET_LOG_PATH" 2>/dev/null || true
}

# 刷新桌面数据库与图标缓存（对应 deb postinst/postrm 里的 update-desktop-database 等）
wemeet_update_caches()
{
	if command -v update-desktop-database >/dev/null 2>&1; then
		update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
	fi
	if command -v gtk-update-icon-cache >/dev/null 2>&1; then
		gtk-update-icon-cache -q /usr/share/icons/hicolor >/dev/null 2>&1 || true
	fi
}
